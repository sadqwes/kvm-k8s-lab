        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(jobhunter_applications_this_week) / max(jobhunter_applications_weekly_target)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
