    {
      "id": 12,
      "type": "timeseries",
      "title": "Результаты бэкапов по расписанию",
      "description": "Сколько бэкапов periodic-backup завершилось каждым статусом за последние 6 часов. Счётчики Velero обнуляются при рестарте его пода.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(velero_backup_success_total{schedule=\"periodic-backup\"}[6h]))",
          "legendFormat": "Completed",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(increase(velero_backup_partial_failure_total{schedule=\"periodic-backup\"}[6h]))",
          "legendFormat": "PartiallyFailed",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum(increase(velero_backup_failure_total{schedule=\"periodic-backup\"}[6h]))",
          "legendFormat": "Failed",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "barAlignment": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Completed"
            },
            "properties": [
