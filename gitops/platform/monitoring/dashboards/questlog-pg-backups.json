    {
      "id": 14,
      "type": "stat",
      "title": "Restore: tables differ",
      "description": "Tables whose row count in the restored dump differs from production. Not always an error: new rows may appear after the dump. Many differences right after a backup = look closer.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 7,
        "w": 4,
        "h": 5
