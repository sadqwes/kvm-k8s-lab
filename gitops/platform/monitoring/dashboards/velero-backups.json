    {
      "id": 9,
      "type": "table",
      "title": "Бэкапы в MinIO",
      "description": "Каждая строка — объект Backup в кластере (а значит, бэкап в бакете velero-backups). Свежие сверху.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 15,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_velero_backup_info",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "kube_velero_backup_start_timestamp * 1000",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "kube_velero_backup_expiration_timestamp * 1000",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "kube_velero_backup_items_backed_up",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "kube_velero_backup_errors",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "namespace": true,
              "customresource_group": true,
              "customresource_kind": true,
              "customresource_version": true,
              "job": true,
              "instance": true,
              "service": true,
              "pod": true,
              "endpoint": true,
              "container": true,
              "Value #A": true,
              "__name__": true
            },
            "indexByName": {
              "name": 0,
              "phase": 1,
              "Value #B": 2,
              "Value #D": 3,
              "Value #E": 4,
              "Value #C": 5,
              "schedule": 6
            },
            "renameByName": {
              "name": "Бэкап",
              "phase": "Статус",
              "Value #B": "Начало",
              "Value #C": "Удалится",
              "Value #D": "Объектов",
              "Value #E": "Ошибок",
              "schedule": "Расписание"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Начало",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Статус"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Completed": {
                        "text": "Completed",
                        "color": "green"
                      },
                      "PartiallyFailed": {
                        "text": "PartiallyFailed",
                        "color": "orange"
                      },
                      "Failed": {
                        "text": "Failed",
                        "color": "red"
                      },
                      "InProgress": {
                        "text": "InProgress",
                        "color": "blue"
                      },
                      "Deleting": {
                        "text": "Deleting",
                        "color": "purple"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Начало"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Удалится"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ошибок"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
