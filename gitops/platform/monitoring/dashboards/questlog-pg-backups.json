    {
      "id": 9,
      "type": "stat",
      "title": "CronJob suspended",
      "description": "If 1, backups do not run at all.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kube_cronjob_spec_suspend{namespace=\"questlog\",cronjob=\"questlog-pg-backup\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "active",
                  "color": "green"
                },
                "1": {
                  "text": "SUSPENDED",
                  "color": "red"
                }
              }
            }
          ],
          "noValue": "no data"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Failed backup jobs",
      "description": "Backup Jobs that still exist and have failed pods (kept by failedJobsHistoryLimit: 3). Read the logs: kubectl -n questlog logs job/<name> -c upload",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 7,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (job_name) (kube_job_status_failed{namespace=\"questlog\",job_name=~\"questlog-pg-backup-.*|pg-backup-.*\"}) > 0) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "options": {
